{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "contract/src",
    "db/src",
    "reliability/src",
    "agent/src",
    "stt/src",
    "server/src",
    "dashboard/src",
    "scripts",
    "*/test"
  ]
}
