# Copy to .env (git-ignored). NEVER commit real values. Server-side only. Every variable below is read by the code
# (server/test/env-example.test.ts fails if this file and the code disagree).

# --- AssemblyAI (Plane 1 only; never read by /reliability or /dashboard) ---
ASSEMBLYAI_API_KEY=
AAI_WS_URL=wss://agents.assemblyai.com/v1/ws
AAI_REST_URL=https://agents.assemblyai.com
AAI_VOICE=

# --- Server ---
HOST=127.0.0.1
PORT=8787
# Required for any non-loopback HOST. The server has NO TLS: put a TLS-terminating proxy in front (browsers only allow the microphone on https or localhost).
TALLY_ALLOW_REMOTE=0
# Required, at least 16 characters. Sent by the dashboard as a header; never put it in a URL.
TALLY_OPERATOR_TOKEN=
# OPTIONAL. The dashboard is served by this server, so its own origin is always allowed to open the mic socket.
# Set this only for a split deployment, to allow ONE extra exact origin, e.g. https://dash.example.com
DASHBOARD_ORIGIN=
# Set to 1 to print request errors to the server console (never sent to clients). Off by default.
TALLY_DEBUG_ERRORS=0

# --- Storage ---
TALLY_DB_PATH=./data/tally.sqlite
TALLY_AUDIO_DIR=./data/audio

# --- Gating parameters ---
# These SEED the baseline config version v1 the first time the server starts on an empty database. After that the ACTIVE config's
# values win (configs are versioned and immutable; create a new version to change them). Sized from spike A (worst measured wait 3470 ms).
EVIDENCE_WAIT_MAX_MS=4000
STT_STALL_MS=2500
MIN_WORD_CONFIDENCE=0.6
REGRESSION_THRESHOLD=3
# Local speech-activity check: quiet time before speech is declared over (the value all tests and live runs used).
LOCAL_VAD_HANGOVER_MS=300
